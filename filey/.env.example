# FILEY · monolito Django — variables de entorno (copiar a .env)

# En producción genera una clave propia (firma las cookies de sesión).
# Con DEBUG=False, el arranque se aborta si esta clave sigue en su valor
# de ejemplo. Genérala con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion

# "true" solo en desarrollo. Si NO se declara, se asume producción
# (DEBUG=False): seguro por defecto. Nunca la pongas en true en un
# servidor expuesto.
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos ─────────────────────────────────────────────
# PostgreSQL es obligatorio, también en desarrollo: cada feria vive en
# su propio schema (ADR-0003) y SQLite no tiene schemas. El arranque
# aborta si esta URL no apunta a Postgres.
#
# Si usas el `docker-compose.yml` del repo puedes omitir esta variable
# —ese es el valor por defecto—. Declárala si tienes tu propia
# instancia, p. ej. la de Homebrew, que suele quedar en otro puerto:
#   DATABASE_URL=postgres://tu_usuario@127.0.0.1:5433/filey_db
DATABASE_URL=postgres://filey_user:filey_password@localhost:5432/filey_db

# URL pública del sistema. Es la base de los enlaces que van dentro de
# los correos (aviso de alta administrativa). En producción, el dominio
# real: si se queda en localhost, los enlaces no le sirven a nadie.
URL_BASE=http://localhost:8000

# ── Pie de página ─────────────────────────────────────────────
# Quién organiza y dónde encontrarlo. Sale en las pantallas de fuera de
# una feria (acceso, «mis ferias», elegir edición) y es el valor por
# omisión de cada edición: una feria puede declarar el suyo desde
# /django-admin/, y lo que deje en blanco lo hereda de aquí.
PIE_ENTIDAD=FILEY
PIE_DEPENDENCIA=Coordinación General de Contenidos · UADY
PIE_CONTACTO=Calle 33A x 20, Tanlum · Mérida, Yucatán · contenidos@filey.org

# ── Archivos que sube la gente (ADR-0007) ─────────────────────
# Actas constitutivas, RFC, comprobantes de pago. Nada de esto se sirve
# por una URL: lo entrega una vista que comprueba quién pregunta.
#
# `local` (por omisión) guarda en el sistema de archivos. `s3` lo manda
# a un almacén de objetos —Supabase Storage, Cloudflare R2, AWS—; pasar
# de uno a otro es cambiar estas variables, sin tocar código.
ALMACENAMIENTO=local

# Solo con ALMACENAMIENTO=local. En desarrollo puedes dejarla vacía: los
# archivos caen en `filey/medios/`, que está en el .gitignore.
#
# **En producción hace falta** mientras no haya almacén de objetos: sin
# ella los archivos van al sistema de archivos del contenedor y se
# borran en cada despliegue. `manage.py check --deploy` lo avisa
# (comun.W001). Apúntala a un disco montado que sobreviva:
#   MEDIA_ROOT=/var/data/medios
MEDIA_ROOT=

# Solo con ALMACENAMIENTO=s3. Las cuatro son obligatorias: el arranque
# aborta si falta alguna, para no perder en silencio lo que se suba.
# El endpoint es lo único que distingue un proveedor de otro. Supabase:
#   S3_ENDPOINT_URL=https://<proyecto>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Solo producción (DEBUG=False) ─────────────────────────────
# Orígenes de confianza para el CSRF, con esquema, coma-separados.
# Ej.: https://filey.org,https://www.filey.org
CSRF_TRUSTED_ORIGINS=
# Poner en "false" solo si un proxy externo ya fuerza HTTPS y la
# redirección de Django causa un bucle. Por defecto redirige a HTTPS.
DJANGO_SSL_REDIRECT=true

# ── Envío real del OTP por Resend ─────────────────────────────
# 1. Entra a https://resend.com/ y genera una API Key.
# 2. Si dejas la API Key vacía, el sistema mostrará un aviso en
#    consola y no enviará los correos (arrojará error al intentarlo).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente que ve el usuario en su bandeja.
# Formato recomendado: "Nombre <correo@tudominio.com>"
# Ejemplo: FILEY <no-reply@filey.org>
# Nota: Para probar sin un dominio verificado, usa "onboarding@resend.dev"
DEFAULT_FROM_EMAIL="FILEY <no-reply@filey.org>"
